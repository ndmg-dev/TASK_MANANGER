# ─── Supabase ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Groq (AI) ──────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Flask ───────────────────────────────────────────
FLASK_SECRET_KEY=your-random-secret-key
FLASK_ENV=development

# ─── GitHub Integration ─────────────────────────────
# Personal Access Token com permissão de repo (para criar PRs)
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-org-or-user
GITHUB_REPO_NAME=your-repo-name
GITHUB_BASE_BRANCH=main

# ─── Organização ────────────────────────────────────
# URL pública do frontend — usada nos links dos e-mails de aviso
APP_BASE_URL=http://localhost:3000

# ─── Brevo — avisos de prazo por e-mail ─────────────
# Única variável obrigatória da automação. Chave em:
# Brevo > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Remetente — precisa estar validado no painel do Brevo.
# Sem esta variável, o default é notificacoes@<ALLOWED_EMAIL_DOMAIN>.
BREVO_SENDER_EMAIL=notificacoes@mendoncagalvao.com.br

# ─── Ajustes opcionais ───────────────────────────────
# Tudo abaixo já tem um default sensato em app/config.py.
# Só defina se precisar de um valor diferente.
#
# ALLOWED_EMAIL_DOMAIN=mendoncagalvao.com.br   # domínio aceito no login
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# BREVO_SENDER_NAME=NDMG Task Manager
# NOTIFICATIONS_ENABLED=true                   # false desliga os avisos
# SCHEDULER_ENABLED=true                       # false desliga o job diário
# SCHEDULER_HOUR=8                             # horário da varredura (0-23)
# SCHEDULER_MINUTE=0
# TIMEZONE=America/Sao_Paulo
# NOTIFY_DAYS_BEFORE=3,1,0                     # dias de antecedência do aviso
# NOTIFY_OVERDUE=true                          # avisa também quando atrasa
# AUTOMATION_TOKEN=                            # só p/ disparo via cron externo
