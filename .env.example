# ─── Supabase ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Groq (AI) ──────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Flask ───────────────────────────────────────────
FLASK_SECRET_KEY=your-random-secret-key
FLASK_ENV=development

# ─── GitHub Integration ─────────────────────────────
# Personal Access Token com permissão de repo (para criar PRs)
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-org-or-user
GITHUB_REPO_NAME=your-repo-name
GITHUB_BASE_BRANCH=main

# ─── Organização ────────────────────────────────────
# Domínio corporativo aceito no login e nas rotas da API
ALLOWED_EMAIL_DOMAIN=mendoncagalvao.com.br
# URL pública do frontend — usada nos links dos e-mails de aviso
APP_BASE_URL=http://localhost:3000
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Brevo — avisos de prazo ────────────────────────
# Chave em Brevo > SMTP & API > API Keys. É a única obrigatória.
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Remetente (precisa estar validado no painel do Brevo)
BREVO_SENDER_EMAIL=notificacoes@mendoncagalvao.com.br
BREVO_SENDER_NAME=NDMG Task Manager

# ─── Automação de avisos de prazo ───────────────────
NOTIFICATIONS_ENABLED=true
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
TIMEZONE=America/Sao_Paulo
# Dias de antecedência que disparam aviso (0 = no dia do vencimento)
NOTIFY_DAYS_BEFORE=3,1,0
# Avisa também no dia seguinte ao prazo estourado
NOTIFY_OVERDUE=true
# Token para disparar a varredura via cron externo (POST /api/notifications/cron)
AUTOMATION_TOKEN=
